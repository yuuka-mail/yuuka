{
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(mise install)",
      "Bash(mise exec -- *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go mod tidy)",
      "Bash(golangci-lint *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.go) cd \"$CLAUDE_PROJECT_DIR\" && mise exec -- golangci-lint fmt \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting Go file"
          }
        ]
      }
    ]
  }
}
