# yuuka's configuration. Copy to yuuka.env next to compose.yaml
# (gitignored) and fill in the empty values. The authoritative list, with
# defaults, is docs/operate/config.md.

# --- Set by compose.yaml; values here are overridden -------------------------
# YUUKA_DATABASE_URL        the yuuka_app role, from YUUKA_DB_APP_PASSWORD in .env
# YUUKA_DATABASE_OWNER_URL  forced empty: only the migrate service, which does not
#                           read this file, gets the yuuka_owner role
# YUUKA_TRUSTED_PROXIES     the edge network plus YUUKA_EXTRA_TRUSTED_PROXIES
#                           from .env
# YUUKA_WEB_ORIGIN          from .env, shared with Caddy
# YUUKA_DATA_DIR            /var/lib/yuuka, the yuuka-data volume (local raw copy)
# YUUKA_LISTEN              0.0.0.0:31480: every interface of the container's own
#                           network, so a proxy can reach it. Published to the
#                           host only by compose.host-caddy.yaml, and then on
#                           127.0.0.1 alone.

# --- R2 (docs/operate/cloudflare.md) -----------------------------------------
# S3 endpoint of the Cloudflare account: https://<account id>.r2.cloudflarestorage.com
YUUKA_R2_ENDPOINT=
# Raw bucket and an Object Read & Write token scoped to it. yuuka reads
# raw/ and writes only, create-only, its sent copies under sent/ and the
# mail it pulls from external mailboxes under pull/.
YUUKA_R2_RAW_BUCKET=
YUUKA_R2_RAW_ACCESS_KEY_ID=
YUUKA_R2_RAW_SECRET_ACCESS_KEY=
# Pending bucket (must differ from the raw one) and a read-write token for it.
YUUKA_R2_PENDING_BUCKET=
YUUKA_R2_PENDING_ACCESS_KEY_ID=
YUUKA_R2_PENDING_SECRET_ACCESS_KEY=

# --- Webhook from the Email Worker -------------------------------------------
# Comma-separated, each at least 32 bytes; list two while rotating. Must
# match the Worker's secret. Generate one: openssl rand -hex 32
YUUKA_WEBHOOK_SECRETS=

# --- Ingest ------------------------------------------------------------------
# Name of the Cloudflare account (default cloudflare). Its row in accounts is
# created on first ingest. Redelivery dedupe is per account, so changing the
# name later starts a new account instead of renaming the old one.
YUUKA_ACCOUNT=
# authserv-id of the account's trusted receiver (default mx.cloudflare.net).
YUUKA_TRUSTED_AUTHSERV_ID=
# Period of the pending/ reconcile in serve (default 5m).
YUUKA_RECONCILE_INTERVAL=

# --- Notifications (optional; set both or neither) ---------------------------
YUUKA_TELEGRAM_BOT_TOKEN=
YUUKA_TELEGRAM_CHAT_ID=

# --- WebUI -------------------------------------------------------------------
# WebAuthn relying party id (default: the host of YUUKA_WEB_ORIGIN). Changing
# it later invalidates every registered passkey.
YUUKA_WEBAUTHN_RP_ID=

# --- Third-party secrets (docs/operate/secrets.md) ---------------------------
# Path of the KEK that seals transport passwords in the database, as mounted
# from compose.override.yaml (a Compose secret, read-only, never on the backup
# volume). Without it, everything but sending through a password-protected
# transport works; with a malformed one serve refuses to start.
# YUUKA_KEK_FILE=/run/secrets/yuuka-kek
# Old KEK files during a rotation, until `yuuka secret rewrap` has run.
# YUUKA_KEK_PREVIOUS_FILES=

# --- Sending (docs/operate/config.md) ----------------------------------------
# Transports live in the database now: `yuuka transport add`.
#
# DEPRECATED, removed in the next release: transports in the environment.
# With YUUKA_KEK_FILE set, serve imports them into the database on start;
# then delete them (docs/operate/secrets.md). Names of the outgoing
# transports, as identities name them. Each name gets its own variables:
# the name uppercased, '.' and '-' turned into '_'.
YUUKA_TRANSPORTS=
# Example for a transport called "cloudflare" (Cloudflare Email Sending):
# YUUKA_TRANSPORT_CLOUDFLARE_HOST=smtp.mx.cloudflare.net
# YUUKA_TRANSPORT_CLOUDFLARE_PORT=465
# YUUKA_TRANSPORT_CLOUDFLARE_USERNAME=
# The password lives in a file, never in this one; mount it into the
# container (README.md, "发信").
# YUUKA_TRANSPORT_CLOUDFLARE_PASSWORD_FILE=/run/secrets/cloudflare-smtp
# Which header fields the exit lets yuuka set: cloudflare, standard, none,
# or a list of message-id, return-path, dkim, status-query. Required.
# YUUKA_TRANSPORT_CLOUDFLARE_CAPS=cloudflare
# Concurrent send attempts (default 2) and how often serve looks for due
# mail (default 30s; mail queued by serve itself goes out at once).
YUUKA_OUTBOX_WORKERS=
YUUKA_OUTBOX_POLL_INTERVAL=

# --- SMTP submission port (docs/operate/submission.md) -----------------------
# Off unless set. Implicit TLS only; inside the container listen on 31465 and
# publish it (on an internal address only) as 465.
YUUKA_SUBMISSION_LISTEN=
# Either yuuka terminates TLS with these PEM files (reloaded when they change)...
YUUKA_SUBMISSION_TLS_CERT_FILE=
YUUKA_SUBMISSION_TLS_KEY_FILE=
# ...or a proxy in front does, and must send the PROXY protocol. Comma-separated
# CIDRs; a separate list from YUUKA_TRUSTED_PROXIES.
YUUKA_SUBMISSION_PROXIES=
# Name in the greeting. Defaults to the certificate's name when yuuka terminates
# TLS; set it when a proxy does, or the WebUI's host name is used instead.
YUUKA_SUBMISSION_HOSTNAME=

# --- MCP over stdio ----------------------------------------------------------
# Bearer token `yuuka mcp --stdio` acts as. Not needed by serve: agents
# normally reach MCP over HTTPS at /mcp with their own token.
YUUKA_MCP_TOKEN=
