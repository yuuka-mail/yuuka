  "info": {
    "title": "yuuka",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/messages": {
      "get": {
        "summary": "List messages, newest first",
        "security": [
          {
            "bearer": [
              "message:read"
            ]
          },
          {
            "session": [
              "message:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "description": "only mail delivered to this prefix@zone, whatever its class",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "class",
            "in": "query",
            "description": "only mail of these classes",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Class"
              }
            }
          },
          {
            "name": "downgraded",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "hide",
              "enum": [
                "hide",
                "include",
                "only"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "next_cursor of the previous page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}": {
      "get": {
        "summary": "Get a message's parsed fields and plain text body",
        "security": [
          {
            "bearer": [
              "message:read"
            ]
          },
          {
            "session": [
              "message:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}/attachments/{part}": {
      "get": {
        "summary": "Download an attachment",
        "security": [
          {
            "bearer": [
              "message:read"
            ]
          },
          {
            "session": [
              "message:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "part",
            "in": "path",
            "description": "the IMAP section of the attachment, as the view lists it",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}(\\.[1-9][0-9]{0,3}){0,15}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {}
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}/view": {
      "get": {
        "summary": "Get the structured view of a message (§8.1)",
        "security": [
          {
            "bearer": [
              "message:read"
            ]
          },
          {
            "session": [
              "message:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Level",
              "default": "part"
            }
          },
          {
