{"cases": [
  {"name": "eq folds both sides",
   "match": {"field": "from.addr", "op": "eq", "value": "billing@example.com"},
   "facts": {"from.addr": "Billing@Example.COM"},
   "want": "match"},
  {"name": "stored address values are folded on load",
   "match": {"field": "from.addr", "op": "eq", "value": "BILLING@example.com"},
   "facts": {"from.addr": "billing@example.com"},
   "want": "match"},
  {"name": "eq is the whole string",
   "match": {"field": "from.addr", "op": "eq", "value": "billing@example"},
   "facts": {"from.addr": "billing@example.com"},
   "want": "no_match"},
  {"name": "from.domain is the part after the last @",
   "match": {"field": "from.domain", "op": "eq", "value": "mail.example.com"},
   "facts": {"from.addr": "\"a@b\"@Mail.Example.com"},
   "want": "match"},
  {"name": "from.domain is not the organization",
   "match": {"field": "from.domain", "op": "eq", "value": "example.com"},
   "facts": {"from.addr": "billing@mail.example.com"},
   "want": "no_match"},
  {"name": "from.org is the registrable domain",
   "match": {"field": "from.org", "op": "eq", "value": "example.com"},
   "facts": {"from.addr": "billing@mail.example.com"},
   "want": "match"},
  {"name": "from.org follows the public suffix list",
   "match": {"field": "from.org", "op": "eq", "value": "example.co.uk"},
   "facts": {"from.addr": "orders@mail.shop.example.co.uk"},
   "want": "match"},
  {"name": "a domain that is a public suffix is its own organization",
   "match": {"field": "from.org", "op": "eq", "value": "co.uk"},
   "facts": {"from.addr": "x@co.uk"},
   "want": "match"},
  {"name": "no From address: from.domain is empty",
   "match": {"field": "from.domain", "op": "regex", "value": "^$"},
   "facts": {"from.addr": ""},
   "want": "match"},
  {"name": "to.addr is prefix@zone, folded",
   "match": {"field": "to.addr", "op": "eq", "value": "svc-aws@example.net"},
   "facts": {"to.prefix": "Svc-AWS", "to.zone": "Example.NET"},
   "want": "match"},
  {"name": "in matches any item",
   "match": {"field": "to.prefix", "op": "in", "value": ["shop", "SVC-AWS"]},
   "facts": {"to.prefix": "svc-aws", "to.zone": "example.net"},
   "want": "match"},
  {"name": "in matches no item",
   "match": {"field": "to.zone", "op": "in", "value": ["example.org"]},
   "facts": {"to.prefix": "svc-aws", "to.zone": "example.net"},
   "want": "no_match"},
  {"name": "contains folds both sides",
   "match": {"field": "subject", "op": "contains", "value": "invoice"},
   "facts": {"subject": "Your INVOICE is ready"},
   "want": "match"},
  {"name": "folding is strings.ToLower: non-ASCII letters fold",
   "match": {"field": "subject", "op": "eq", "value": "ÉCOLE"},
   "facts": {"subject": "école"},
   "want": "match"},
  {"name": "folding is not full case folding: ß does not equal SS",
   "match": {"field": "subject", "op": "eq", "value": "STRASSE"},
   "facts": {"subject": "Straße"},
   "want": "no_match"},
  {"name": "no Unicode normalization: precomposed and combining differ",
   "match": {"field": "subject", "op": "contains", "value": "école"},
   "facts": {"subject": "e\u0301cole"},
   "want": "no_match"},
  {"name": "regex runs on the original text and is case-sensitive",
   "match": {"field": "subject", "op": "regex", "value": "invoice"},
   "facts": {"subject": "Invoice 42"},
   "want": "no_match"},
  {"name": "regex case-insensitivity is spelled (?i)",
   "match": {"field": "subject", "op": "regex", "value": "(?i)invoice|receipt"},
   "facts": {"subject": "Your RECEIPT"},
   "want": "match"},
  {"name": "regex is unanchored RE2",
   "match": {"field": "subject", "op": "regex", "value": "\\border\\b \\d+"},
   "facts": {"subject": "Re: order 1234 shipped"},
   "want": "match"},
  {"name": "regex on an address field sees the folded address",
   "match": {"field": "from.addr", "op": "regex", "value": "^billing@"},
   "facts": {"from.addr": "Billing@Example.com"},
   "want": "match"},
  {"name": "regex on an address field never sees capitals",
   "match": {"field": "from.addr", "op": "regex", "value": "^Billing@"},
   "facts": {"from.addr": "Billing@Example.com"},
   "want": "no_match"},
  {"name": "body contains sees the whole body",
   "match": {"field": "body", "op": "contains", "value": "NEEDLE"},
   "facts": {"body": [{"repeat": "a", "count": 70000}, "needle"]},
   "want": "match"},
  {"name": "body regex sees only the first 64 KiB",
   "match": {"field": "body", "op": "regex", "value": "needle"},
   "facts": {"body": [{"repeat": "a", "count": 70000}, "needle"]},
   "want": "no_match"},
  {"name": "body regex sees text ending exactly at 64 KiB",
   "match": {"field": "body", "op": "regex", "value": "needle$"},
   "facts": {"body": [{"repeat": "a", "count": 65530}, "needle"]},
   "want": "match"},
  {"name": "the window does not split a UTF-8 sequence",
   "match": {"field": "body", "op": "regex", "value": "a$"},
   "facts": {"body": [{"repeat": "a", "count": 65535}, "é tail"]},
   "want": "match"},
  {"name": "a character straddling 64 KiB is outside the window",
   "match": {"field": "body", "op": "regex", "value": "é"},
   "facts": {"body": [{"repeat": "a", "count": 65535}, "é tail"]},
   "want": "no_match"},
  {"name": "list.id is the identifier inside the brackets",
   "match": {"field": "list.id", "op": "eq", "value": "dev.lists.example.org"},
   "facts": {"list.id": "Dev Talk <Dev.Lists.Example.org>"},
   "want": "match"},
  {"name": "list.id without brackets is the trimmed value",
   "match": {"field": "list.id", "op": "eq", "value": "dev.lists.example.org"},
   "facts": {"list.id": "  dev.lists.example.org "},
   "want": "match"},
  {"name": "no list.id never equals a value",
   "match": {"field": "list.id", "op": "contains", "value": "example"},
   "facts": {},
   "want": "no_match"}
]}
