{"cases": [
  {"name": "all needs every child",
   "match": {"all": [
     {"field": "to.prefix", "op": "eq", "value": "svc-aws"},
     {"field": "from.verified", "op": "eq", "value": true}]},
   "facts": {"to.prefix": "svc-aws", "to.zone": "example.net"},
   "want": "no_match"},
  {"name": "any needs one child",
   "match": {"any": [
     {"field": "to.prefix", "op": "eq", "value": "shop"},
     {"field": "subject", "op": "contains", "value": "receipt"}]},
   "facts": {"subject": "Receipt for your order"},
   "want": "match"},
  {"name": "not inverts",
   "match": {"not": {"field": "from.verified", "op": "eq", "value": true}},
   "facts": {"from.verified": false},
   "want": "match"},
  {"name": "a single-child all is the child",
   "match": {"all": [{"field": "attachment", "op": "eq", "value": true}]},
   "facts": {"attachment": true},
   "want": "match"},
  {"name": "the design example",
   "match": {"all": [
     {"field": "to.addr", "op": "eq", "value": "svc-aws@example.com"},
     {"field": "from.org", "op": "eq", "value": "example.com"},
     {"field": "from.verified", "op": "eq", "value": true},
     {"any": [{"field": "subject", "op": "regex", "value": "(?i)invoice|receipt"},
              {"field": "extraction", "op": "has", "value": "amount"}]}]},
   "facts": {"from.addr": "billing@aws.example.com", "from.verified": true,
             "to.prefix": "svc-aws", "to.zone": "example.com",
             "subject": "Monthly statement", "extraction": ["amount"]},
   "want": "match"},
  {"name": "the design example, forged From",
   "match": {"all": [
     {"field": "to.addr", "op": "eq", "value": "svc-aws@example.com"},
     {"field": "from.org", "op": "eq", "value": "example.com"},
     {"field": "from.verified", "op": "eq", "value": true},
     {"any": [{"field": "subject", "op": "regex", "value": "(?i)invoice|receipt"},
              {"field": "extraction", "op": "has", "value": "amount"}]}]},
   "facts": {"from.addr": "billing@aws.example.com", "from.verified": false,
             "to.prefix": "svc-aws", "to.zone": "example.com",
             "subject": "Invoice", "extraction": ["amount"]},
   "want": "no_match"}
]}
