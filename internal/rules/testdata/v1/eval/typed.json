   "facts": {"from.verified": true},
   "want": "match"},
  {"name": "from.verified defaults to false",
   "match": {"field": "from.verified", "op": "eq", "value": true},
   "facts": {},
   "want": "no_match"},
  {"name": "prefix.claimed eq false",
   "match": {"field": "prefix.claimed", "op": "eq", "value": false},
   "facts": {"prefix.claimed": false},
   "want": "match"},
  {"name": "attachment",
   "match": {"field": "attachment", "op": "eq", "value": true},
   "facts": {"attachment": true},
   "want": "match"},
  {"name": "class eq",
   "match": {"field": "class", "op": "eq", "value": "machine"},
   "facts": {"class": "machine"},
   "want": "match"},
  {"name": "an unclassified message is class unknown",
   "match": {"field": "class", "op": "in", "value": ["human", "unknown"]},
   "facts": {},
   "want": "match"},
  {"name": "class in without the message's class",
   "match": {"field": "class", "op": "in", "value": ["human"]},
   "facts": {"class": "machine"},
   "want": "no_match"},
  {"name": "verdict has leak",
   "match": {"field": "verdict", "op": "has", "value": "leak"},
   "facts": {"verdict": ["leak"]},
   "want": "match"},
  {"name": "verdict has spoof when only leak",
   "match": {"field": "verdict", "op": "has", "value": "spoof"},
   "facts": {"verdict": ["leak"]},
   "want": "no_match"},
  {"name": "extraction has",
   "match": {"field": "extraction", "op": "has", "value": "otp"},
   "facts": {"extraction": ["link", "otp"]},
   "want": "match"},
  {"name": "extraction has on a message without extractions",
   "match": {"field": "extraction", "op": "has", "value": "amount"},
   "facts": {},
   "want": "no_match"}
]}
