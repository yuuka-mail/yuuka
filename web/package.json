{
  "name": "yuuka-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen": "openapi-typescript ../internal/api/openapi.json -o src/api/schema.gen.ts",
    "i18n": "node scripts/paraglide.mjs",
    "check": "pnpm run gen --check && pnpm run i18n && tsc --noEmit && oxlint --deny-warnings src scripts && oxfmt --check && vitest run",
    "fmt": "oxfmt",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@inlang/paraglide-js-react": "1.0.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.0",
    "@inlang/plugin-message-format": "4.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
